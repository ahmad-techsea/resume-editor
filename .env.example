# Groq API key — powers the review panel's two judgment rules (writing quality, leadership signal).
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Model used by /api/complete. Defaults to qwen/qwen3-32b, Groq's Qwen 3 offering.
# Check https://console.groq.com/docs/models for what's enabled on your account.
GROQ_MODEL=qwen/qwen3-32b
